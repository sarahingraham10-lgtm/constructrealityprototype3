# Copy these into your hosting service's "environment variables" (or export them before `npm start`).
STAFF_PIN=change-this-4-to-8-digits
ADMIN_KEY=change-this-long-random-text
# Optional: turns on the AI helper. Without it the app still works with built-in layouts and tips.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
PORT=3000
